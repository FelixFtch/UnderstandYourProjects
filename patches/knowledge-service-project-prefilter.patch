+# ── UYP project-knowledge prefilter (launch-prep 2026-10-10) ──
+# project_knowledge pages are mirrored project KnowledgeVersions, not
+# household memories.  Two isolation rules, both enforced READ-TIME and
+# FAIL-CLOSED:
+#   1. A request with no "project"/"grant_epoch" params (every legacy
+#      caller: voice, family chat) sees ZERO project_knowledge blocks.
+#   2. A request that does carry them sees only blocks whose slug lives
+#      under project_knowledge/<that project>/<that grant epoch>/, minus
+#      anything carrying a revoked marker: the uyp_revoked: true tombstone
+#      frontmatter the publisher writes on revoke, its body phrase (checked
+#      too because chunk_text may or may not include frontmatter), and any
+#      page carrying the marker itself.
+# Ambiguity resolves to EXCLUSION, never to an error: a mismatched or
+# half-specified request just gets empty results, so this filter cannot be
+# used as an oracle for which projects or grant epochs exist.
+def _project_scope_of(params: dict | None) -> tuple[str, str]:
+    """(project, grant_epoch) request params, stripped ('' when absent)."""
+    return (str((params or {}).get("project", "")).strip(),
+            str((params or {}).get("grant_epoch", "")).strip())
+
+
+def _scoped_project_block(b: dict, project: str, epoch: str) -> bool:
+    """True when b is a project_knowledge block THIS scope may see: slug
+    under project_knowledge/<project>/<epoch>/ and no revoked marker.
+    Same validity rule project_scope_filter enforces, factored out so the
+    ranking stage (F1 fix below) reserves slots only for blocks the
+    read-time filter would actually keep."""
+    source = str(b.get("source", ""))
+    if not source.startswith("project_knowledge/"):
+        return False
+    parts = source.split("/")
+    # expected shape: project_knowledge/<project>/<grant_epoch>/<relpath...>
+    if len(parts) < 4 or parts[1] != project or parts[2] != epoch:
+        return False  # different project or grant epoch: excluded
+    text = str(b.get("text", ""))
+    if ("uyp_revoked: true" in text
+            or "uyp_revoked: true" in text.replace('"', "")
+            or "grant epoch behind these pages was revoked" in text):
+        return False  # revoked epoch's tombstone or a marked page: excluded
+    return True
+
+
+def project_scope_filter(blocks: list[dict], params: dict) -> list[dict]:
+    project, epoch = _project_scope_of(params)
+    if not (project and epoch):
+        # No project scope on the request: drop every project block.  This
+        # is the default path for all existing callers.
+        return [b for b in blocks
+                if not str(b.get("source", "")).startswith("project_knowledge/")]
+    kept: list[dict] = []
+    for b in blocks:
+        source = str(b.get("source", ""))
+        if not source.startswith("project_knowledge/"):
+            kept.append(b)  # family/personal/public blocks: unchanged
+            continue
+        if _scoped_project_block(b, project, epoch):
+            kept.append(b)
+    return kept
+
+
+# ── F1 fix (2026-10-10): slot reservation for scoped requests ──
+# multi_brain_search() merges every accessible brain into ONE global
+# top-10 by score.  Family/public hybrid-expansion noise scores 0.82-0.87
+# even for queries that match nothing there, so (with lexical-only scores
+# before the project serve's embed provider was wired) project blocks
+# could never reach the top-10 -- project_scope_filter then had nothing
+# to keep: it can only drop blocks, never rescue them.  Reservation runs
+# at the RANKING stage, before any filter: a project-scoped request's
+# final top-N must include up to PROJECT_RESERVED_SLOTS of the scoped
+# brain's highest-scoring VALID blocks (same project+epoch+tombstone
+# validation the filter enforces -- the read-time filter stays the
+# authority and still runs, unchanged, on the result).  Scope-INVALID
+# project blocks never occupy a slot (the filter would drop them anyway;
+# admitting them only wastes slots).  UNscoped requests (every legacy
+# caller: voice, family chat) are byte-identical to the old behavior.
+PROJECT_RESERVED_SLOTS = 5
+PROJECT_SLOT_FLOOR = 0.05  # real hits score >= ~0.16 lexical / ~0.85 hybrid;
+                          # below this floor a block never displaces anything
+
+
+def _reserve_project_slots(all_blocks: list[dict], params: dict | None,
+                           total: int = 10) -> list[dict]:
+    """all_blocks must be echo-filtered and sorted by score descending.
+    Scoped request: top-`total` with up to PROJECT_RESERVED_SLOTS valid
+    scoped project blocks (each >= PROJECT_SLOT_FLOOR) guaranteed in,
+    remaining slots filled by global score order.  Unscoped request:
+    plain all_blocks[:total] (pre-F1 behavior, byte-identical)."""
+    project, epoch = _project_scope_of(params)
+    if not (project and epoch):
+        # Unscoped request (every legacy caller: voice, family chat):
+        # project blocks are dropped downstream anyway; once the project
+        # serve's embed provider is wired they score family-level (~0.83+)
+        # and can crowd the global cut, silently starving family results
+        # (observed 9-of-10 family blocks after the embed fix).  Cut from
+        # the non-project pool so unscoped responses keep their pre-F1
+        # shape exactly -- same blocks, same order, same count.
+        return [b for b in all_blocks
+                if not str(b.get("source", "")).startswith("project_knowledge/")][:total]
+    # Eligible fill: everything except scope-INVALID project blocks (the
+    # downstream filter would drop those anyway, so admitting them only
+    # wastes slots; the caller still sees exactly the family/personal/
+    # public blocks an unscoped request would see -- nothing is revealed).
+    eligible = [b for b in all_blocks
+                if not str(b.get("source", "")).startswith("project_knowledge/")
+                or _scoped_project_block(b, project, epoch)]
+    reserved = [b for b in eligible
+                if str(b.get("source", "")).startswith("project_knowledge/")
+                and float(b.get("score", 0) or 0) >= PROJECT_SLOT_FLOOR]
+    reserved = reserved[:PROJECT_RESERVED_SLOTS]
+    if not reserved:
+        return eligible[:total]
+    rids = {id(b) for b in reserved}
+    fill = [b for b in eligible if id(b) not in rids]
+    merged = reserved + fill[: total - len(reserved)]
+    merged.sort(key=lambda b: float(b.get("score", 0) or 0), reverse=True)
+    return merged
+
